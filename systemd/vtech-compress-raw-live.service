[Unit]
Description=VTech raw/live .dbn compressor (one-shot)
Documentation=file:///opt/vtech/scripts/ops/compress_raw_live.sh
After=network-online.target opt-vtech-data.mount
Wants=opt-vtech-data.mount

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/vtech
# Environment overrides (optional):
#   VTECH_LIVE_DIR       — override input directory
#   VTECH_COMPRESS_LEVEL — override zstd level (default 13)
ExecStart=/bin/bash /opt/vtech/scripts/ops/compress_raw_live.sh
Nice=15
IOSchedulingClass=idle
StandardOutput=append:/opt/vtech/logs/compress-raw-live.log
StandardError=append:/opt/vtech/logs/compress-raw-live.err

# Keep the service scoped: only allow writes under the data tree.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vtech/data /opt/vtech/logs
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
