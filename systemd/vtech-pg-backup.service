[Unit]
Description=VTech PostgreSQL Backup (pgBackRest)
After=postgresql@16-main.service network-online.target
Requires=postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
WorkingDirectory=/opt/vtech
ExecStart=/bin/bash /opt/vtech/scripts/ops/pg_backup.sh
StandardOutput=append:/opt/vtech/logs/pg-backup.log
StandardError=append:/opt/vtech/logs/pg-backup.err
TimeoutStartSec=14400

[Install]
WantedBy=multi-user.target
